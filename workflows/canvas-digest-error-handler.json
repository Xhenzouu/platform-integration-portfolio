        "jsCode": "const errorData = $input.first().json;\n\nconst workflowName = errorData.workflow?.name || 'Unknown Workflow';\nconst executionId = errorData.execution?.id || 'Unknown ID';\nconst failedNode = errorData.execution?.lastNodeExecuted || 'Unknown Node';\nconst rawMessage = errorData.error?.message || 'No error message provided';\n\n// Clean the message (even though it's a clean string now, this is safe)\nconst cleanMessage = rawMessage.replace(/<[^>]*>?/gm, '').replace(/\\s+/g, ' ').trim().substring(0, 300);\n\nconst text = `ðŸš¨ *Workflow Failed:* ${workflowName}\n*Execution ID:* ${executionId}\n*Failing Node:* ${failedNode}\n*Error:* \\`${cleanMessage}\\``;\n\nreturn [{\n  json: {\n    text: text\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
