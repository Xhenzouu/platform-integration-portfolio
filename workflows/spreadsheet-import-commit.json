          "name": "Supabase Postgres (v2)"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE spreadsheet_import_runs\nSET status = 'committed',\n    committed_at = NOW()\nWHERE id IN (\n  SELECT DISTINCT import_run_id\n  FROM spreadsheet_staging\n  WHERE review_status = 'committed'\n)\nAND status = 'reviewed'\nRETURNING id, status;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
