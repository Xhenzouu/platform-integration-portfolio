      "id": "YOUR_UUID",
      "name": "Every 15 Minutes"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  id,\n  import_run_id,\n  normalized_row->>'location' AS location,\n  (normalized_row->>'sale_date')::date AS sale_date,\n  normalized_row->>'sku' AS sku,\n  (normalized_row->>'quantity')::integer AS quantity,\n  (normalized_row->>'unit_price')::numeric AS unit_price,\n  (normalized_row->>'total')::numeric AS total\nFROM spreadsheet_staging\nWHERE review_status = 'approved'\nORDER BY import_run_id, id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        208,
        0
      ],
      "id": "YOUR_UUID",
      "name": "Read Approved Rows",
      "credentials": {
        "postgres": {
          "id": "qMvaRhJDoZWarixG",
          "name": "Supabase Postgres (v2)"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO sales_unified (\n  location, sale_date, sku, quantity, unit_price, total, source_import_run_id\n)\nSELECT\n  normalized_row->>'location',\n  (normalized_row->>'sale_date')::date,\n  normalized_row->>'sku',\n  (normalized_row->>'quantity')::integer,\n  (normalized_row->>'unit_price')::numeric,\n  (normalized_row->>'total')::numeric,\n  import_run_id\nFROM spreadsheet_staging\nWHERE review_status = 'approved'\nON CONFLICT (location, sale_date, sku, unit_price) DO NOTHING\nRETURNING id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        416,
        0
      ],
      "id": "YOUR_UUID",
      "name": "Insert to Sales Unified",
      "credentials": {
        "postgres": {
          "id": "qMvaRhJDoZWarixG",
          "name": "Supabase Postgres (v2)"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE spreadsheet_staging\nSET review_status = 'committed',\n    reviewed_at = NOW()\nWHERE review_status = 'approved'\nRETURNING id;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        624,
        0
      ],
      "id": "YOUR_UUID",
      "name": "Mark Rows Committed",
